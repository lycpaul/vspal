{
    "name": "vscode-pets",
    "displayName": "vsPal",
    "description": "Pets for your VS Code",
    "version": "1.37.0",
    "engines": {
        "vscode": "^1.73.0",
        "node": "^24.22.2 || ^26.13.0"
    },
    "packageManager": "npm@11.20.0",
    "l10n": "./l10n",
    "repository": {
        "type": "github",
        "url": "https://github.com/tonybaloney/vscode-pets"
    },
    "homepage": "https://tonybaloney.github.io/vscode-pets",
    "bugs": "https://github.com/tonybaloney/vscode-pets/issues",
    "publisher": "tonybaloney",
    "categories": [
        "Other"
    ],
    "keywords": [
        "pet",
        "cat",
        "chicken",
        "dog",
        "pets",
        "clippy",
        "rubber duck",
        "horse",
        "squirrel",
        "skeleton",
        "deno"
    ],
    "license": "MIT",
    "icon": "icon.png",
    "activationEvents": [
        "onCommand:vscode-pets.start",
        "onCommand:vscode-pets.throw-with-mouse",
        "onCommand:vscode-pets.throw-ball",
        "onCommand:vscode-pets.pat-pet",
        "onCommand:vscode-pets.spawn-pet",
        "onCommand:vscode-pets.delete-pet",
        "onCommand:vscode-pets.remove-all-pets",
        "onCommand:vscode-pets.roll-call",
        "onCommand:vscode-pets.export-pet-list",
        "onCommand:vscode-pets.import-pet-list",
        "onCommand:vscode-pets.change-theme",
        "onWebviewPanel:petCoding",
        "onView:explorer",
        "onView:petsView",
        "onStartupFinished"
    ],
    "main": "./out/extension/extension.js",
    "browser": "./dist/web/extension-web.js",
    "contributes": {
        "views": {
            "explorer": [
                {
                    "type": "webview",
                    "id": "petsView",
                    "name": "%vscode-pets.panel.title%",
                    "when": "vscode-pets.position == 'explorer'",
                    "icon": "media/dog.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "vscode-pets.spawn-pet",
                    "when": "view == petsView",
                    "group": "navigation@1"
                },
                {
                    "command": "vscode-pets.throw-ball",
                    "when": "view == petsView",
                    "group": "navigation@2"
                },
                {
                    "command": "vscode-pets.pat-pet",
                    "when": "view == petsView",
                    "group": "navigation@3"
                },
                {
                    "command": "vscode-pets.delete-pet",
                    "when": "view == petsView",
                    "group": "navigation@4"
                },
                {
                    "command": "vscode-pets.change-theme",
                    "when": "view == petsView",
                    "group": "navigation@5"
                }
            ]
        },
        "commands": [
            {
                "command": "vscode-pets.start",
                "title": "%vscode-pets.start.title%",
                "category": "Pet Coding",
                "icon": "media/dog.svg"
            },
            {
                "command": "vscode-pets.throw-with-mouse",
                "title": "%vscode-pets.throw-with-mouse.title%",
                "category": "Pet Coding",
                "icon": {
                    "dark": "media/icon/dark-throw-outline.svg",
                    "light": "media/icon/light-throw-outline.svg"
                }
            },
            {
                "command": "vscode-pets.throw-ball",
                "title": "%vscode-pets.throw-ball.title%",
                "category": "Pet Coding",
                "icon": {
                    "dark": "media/icon/dark-circle-outline.svg",
                    "light": "media/icon/light-circle-outline.svg"
                }
            },
            {
                "command": "vscode-pets.pat-pet",
                "title": "%vscode-pets.pat-pet.title%",
                "category": "Pet Coding",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "vscode-pets.export-pet-list",
                "title": "%vscode-pets.export-pet-list.title%",
                "category": "Pet Coding"
            },
            {
                "command": "vscode-pets.import-pet-list",
                "title": "%vscode-pets.import-pet-list.title%",
                "category": "Pet Coding"
            },
            {
                "command": "vscode-pets.spawn-pet",
                "title": "%vscode-pets.spawn-pet.title%",
                "category": "Pet Coding",
                "icon": {
                    "dark": "media/icon/dark-add.svg",
                    "light": "media/icon/light-add.svg"
                }
            },
            {
                "command": "vscode-pets.delete-pet",
                "title": "%vscode-pets.delete-pet.title%",
                "category": "Pet Coding",
                "icon": {
                    "dark": "media/icon/dark-trash.svg",
                    "light": "media/icon/light-trash.svg"
                }
            },
            {
                "command": "vscode-pets.remove-all-pets",
                "title": "%vscode-pets.remove-all-pets.title%",
                "category": "Pet Coding",
                "icon": {
                    "dark": "media/icon/dark-trash.svg",
                    "light": "media/icon/light-trash.svg"
                }
            },
            {
                "command": "vscode-pets.roll-call",
                "title": "%vscode-pets.roll-call.title%",
                "category": "Pet Coding"
            },
            {
                "command": "vscode-pets.change-theme",
                "title": "%vscode-pets.change-theme.title%",
                "category": "Pet Coding",
                "icon": {
                    "dark": "media/icon/dark-paintcan.svg",
                    "light": "media/icon/light-paintcan.svg"
                }
            }
        ],
        "configuration": [
            {
                "title": "vsPal",
                "properties": {
                    "vscode-pets.petColor": {
                        "type": "string",
                        "enum": [
                            "black",
                            "blue",
                            "codex",
                            "claudecode",
                            "side_eye",
                            "plus_eyes",
                            "equals_eyes",
                            "cross_eyes",
                            "slant_eyes",
                            "arch_eyes",
                            "caret_eyes",
                            "ring_eyes",
                            "dot_eyes",
                            "squint_eyes",
                            "openai_light",
                            "openai_dark",
                            "octocat",
                            "lightbrown",
                            "brown",
                            "whiteface",
                            "piedpearl",
                            "green",
                            "yellow",
                            "gray",
                            "gray_jimothy",
                            "purple",
                            "red",
                            "white",
                            "orange",
                            "akita",
                            "socks black",
                            "socks beige",
                            "socks brown",
                            "paint beige",
                            "paint black",
                            "paint brown",
                            "magical",
                            "warrior",
                            "pink",
                            "solid_white",
                            "chocolate",
                            "cream",
                            "brown_tabby",
                            "silver_tabby",
                            "ginger_tabby",
                            "cream_tabby",
                            "gray_white",
                            "ginger_white",
                            "tabby_white",
                            "tortoiseshell",
                            "dilute_tortie",
                            "calico",
                            "dilute_calico",
                            "seal_point",
                            "blue_point"
                        ],
                        "default": "brown",
                        "description": "%vscode-pets.petColor.description%",
                        "scope": "window",
                        "enumItemLabels": [
                            "%vscode-pets.petColor.black%",
                            "%vscode-pets.petColor.blue%",
                            "%vscode-pets.petColor.codex%",
                            "%vscode-pets.petColor.claudecode%",
                            "%vscode-pets.petColor.side_eye%",
                            "%vscode-pets.petColor.plus_eyes%",
                            "%vscode-pets.petColor.equals_eyes%",
                            "%vscode-pets.petColor.cross_eyes%",
                            "%vscode-pets.petColor.slant_eyes%",
                            "%vscode-pets.petColor.arch_eyes%",
                            "%vscode-pets.petColor.caret_eyes%",
                            "%vscode-pets.petColor.ring_eyes%",
                            "%vscode-pets.petColor.dot_eyes%",
                            "%vscode-pets.petColor.squint_eyes%",
                            "%vscode-pets.petColor.openai_light%",
                            "%vscode-pets.petColor.openai_dark%",
                            "%vscode-pets.petColor.octocat%",
                            "%vscode-pets.petColor.lightbrown%",
                            "%vscode-pets.petColor.brown%",
                            "%vscode-pets.petColor.whiteface%",
                            "%vscode-pets.petColor.piedpearl%",
                            "%vscode-pets.petColor.green%",
                            "%vscode-pets.petColor.yellow%",
                            "%vscode-pets.petColor.gray%",
                            "%vscode-pets.petColor.gray_jimothy%",
                            "%vscode-pets.petColor.purple%",
                            "%vscode-pets.petColor.red%",
                            "%vscode-pets.petColor.white%",
                            "%vscode-pets.petColor.orange%",
                            "%vscode-pets.petColor.akita%",
                            "%vscode-pets.petColor.socks black%",
                            "%vscode-pets.petColor.socks beige%",
                            "%vscode-pets.petColor.socks brown%",
                            "%vscode-pets.petColor.paint beige%",
                            "%vscode-pets.petColor.paint black%",
                            "%vscode-pets.petColor.paint brown%",
                            "%vscode-pets.petColor.magical%",
                            "%vscode-pets.petColor.warrior%",
                            "%vscode-pets.petColor.pink%",
                            "%vscode-pets.petColor.solid_white%",
                            "%vscode-pets.petColor.chocolate%",
                            "%vscode-pets.petColor.cream%",
                            "%vscode-pets.petColor.brown_tabby%",
                            "%vscode-pets.petColor.silver_tabby%",
                            "%vscode-pets.petColor.ginger_tabby%",
                            "%vscode-pets.petColor.cream_tabby%",
                            "%vscode-pets.petColor.gray_white%",
                            "%vscode-pets.petColor.ginger_white%",
                            "%vscode-pets.petColor.tabby_white%",
                            "%vscode-pets.petColor.tortoiseshell%",
                            "%vscode-pets.petColor.dilute_tortie%",
                            "%vscode-pets.petColor.calico%",
                            "%vscode-pets.petColor.dilute_calico%",
                            "%vscode-pets.petColor.seal_point%",
                            "%vscode-pets.petColor.blue_point%"
                        ]
                    },
                    "vscode-pets.petType": {
                        "type": "string",
                        "enum": [
                            "cat",
                            "chicken",
                            "crab",
                            "clippy",
                            "cockatiel",
                            "dog",
                            "fox",
                            "frog",
                            "horse",
                            "mod",
                            "monkey",
                            "rat",
                            "rocky",
                            "rubber-duck",
                            "snake",
                            "squirrel",
                            "totoro",
                            "turtle",
                            "zappy",
                            "snail",
                            "bunny",
                            "skeleton",
                            "deno",
                            "agent",
                            "finley",
                            "morph",
                            "panda"
                        ],
                        "default": "cat",
                        "description": "%vscode-pets.petType.description%",
                        "scope": "window",
                        "enumItemLabels": [
                            "%vscode-pets.petType.cat%",
                            "%vscode-pets.petType.chicken%",
                            "%vscode-pets.petType.crab%",
                            "%vscode-pets.petType.clippy%",
                            "%vscode-pets.petType.cockatiel%",
                            "%vscode-pets.petType.dog%",
                            "%vscode-pets.petType.fox%",
                            "%vscode-pets.petType.frog%",
                            "%vscode-pets.petType.horse%",
                            "%vscode-pets.petType.mod%",
                            "%vscode-pets.petType.monkey%",
                            "%vscode-pets.petType.rat%",
                            "%vscode-pets.petType.rocky%",
                            "%vscode-pets.petType.rubber-duck%",
                            "%vscode-pets.petType.snake%",
                            "%vscode-pets.petType.squirrel%",
                            "%vscode-pets.petType.totoro%",
                            "%vscode-pets.petType.turtle%",
                            "%vscode-pets.petType.zappy%",
                            "%vscode-pets.petType.snail%",
                            "%vscode-pets.petType.bunny%",
                            "%vscode-pets.petType.skeleton%",
                            "%vscode-pets.petType.deno%",
                            "%vscode-pets.petType.agent%",
                            "%vscode-pets.petType.finley%",
                            "%vscode-pets.petType.morph%",
                            "%vscode-pets.petType.panda%"
                        ]
                    },
                    "vscode-pets.petSize": {
                        "type": "string",
                        "enum": [
                            "nano",
                            "small",
                            "medium",
                            "large"
                        ],
                        "default": "nano",
                        "description": "%vscode-pets.petSize.description%",
                        "enumItemLabels": [
                            "%vscode-pets.petSize.nano%",
                            "%vscode-pets.petSize.small%",
                            "%vscode-pets.petSize.medium%",
                            "%vscode-pets.petSize.large%"
                        ]
                    },
                    "vscode-pets.position": {
                        "type": "string",
                        "enum": [
                            "panel",
                            "explorer"
                        ],
                        "default": "explorer",
                        "description": "%vscode-pets.position.description%",
                        "enumItemLabels": [
                            "%vscode-pets.position.panel%",
                            "%vscode-pets.position.explorer%"
                        ]
                    },
                    "vscode-pets.theme": {
                        "type": "string",
                        "enum": [
                            "none",
                            "forest",
                            "castle",
                            "beach",
                            "winter",
                            "autumn",
                            "library",
                            "barn"
                        ],
                        "default": "none",
                        "description": "%vscode-pets.theme.description%",
                        "enumItemLabels": [
                            "%vscode-pets.theme.none%",
                            "%vscode-pets.theme.forest%",
                            "%vscode-pets.theme.castle%",
                            "%vscode-pets.theme.beach%",
                            "%vscode-pets.theme.winter%",
                            "%vscode-pets.theme.autumn%",
                            "%vscode-pets.theme.library%",
                            "%vscode-pets.theme.barn%"
                        ]
                    },
                    "vscode-pets.petChat.model": {
                        "type": "string",
                        "default": "gpt-6-luna",
                        "scope": "application",
                        "description": "%vscode-pets.petChat.model.description%"
                    },
                    "vscode-pets.petChat.reasoningEffort": {
                        "type": "string",
                        "enum": ["low", "medium", "high", "xhigh", "max", "ultra"],
                        "default": "low",
                        "scope": "application",
                        "description": "%vscode-pets.petChat.reasoningEffort.description%"
                    },
                    "vscode-pets.throwBallWithMouse": {
                        "type": "boolean",
                        "default": false,
                        "description": "%vscode-pets.throwBallWithMouse.description%"
                    },
                    "vscode-pets.disableEffects": {
                        "type": "boolean",
                        "default": false,
                        "description": "%vscode-pets.disableEffects.description%"
                    }
                }
            }
        ]
    },
    "scripts": {
        "generate:finley": "node scripts/generate-finley.mjs",
        "vscode:prepublish": "npm run compile",
        "compile:panel": "webpack",
        "compile:extension": "tsc -p ./tsconfig.extension.json",
        "compile:test": "tsc -p ./tsconfig.test.json",
        "compile:web": "webpack",
        "compile": "npm run compile:panel && npm run compile:extension && npm run compile:test && npm run compile:web",
        "watch": "webpack && tsc -watch -p ./tsconfig.extension.json",
        "watch:web": "webpack --watch",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src && prettier --check src",
        "lint:fix": "eslint src --fix && prettier --write src",
        "test": "node ./out/test/runTest.js",
        "test:coverage": "cross-env COVERAGE=1 node ./out/test/runTest.js",
        "test:web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
        "test:gifs": "node ./out/test/gifs.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@rbarilani/remove-source-map-url-webpack-plugin": "^1.1.0",
        "@types/jsdom": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.6",
        "@types/vscode": "1.73.0",
        "@types/yauzl": "^3.4.0",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/test-web": "^0.0.81",
        "@vscode/vsce": "4.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.15.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "glob": "^14.0.2",
        "jsdom": "^30.1.3",
        "mocha": "^12.0.3",
        "nyc": "^18.0.0",
        "path-browserify": "^1.0.1",
        "prettier": "^3.9.10",
        "process": "^0.11.10",
        "ts-loader": "^9.6.2",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.73.0",
        "webpack": "^5.112.2",
        "webpack-cli": "^7.2.3",
        "yauzl": "^3.4.0"
    }
}
